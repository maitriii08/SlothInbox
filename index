<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#121815">
    <title>SlothInbox 🦥 | Local-First Clutter Tidier & Inbox Automation</title>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* ==========================================================================
           1. CORE CSS RESET & VARIABLES (Comprehensive Architecture)
           ========================================================================== */
        :root {
            --bg-deep: #121815;
            --bg-card: rgba(20, 28, 24, 0.85);
            --border-glass: rgba(255, 255, 255, 0.08);
            --border-glass-top: rgba(255, 255, 255, 0.2);
            --accent-green: #10b981;
            --accent-hover: #059669;
            --accent-shadow: #047857;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --sloth-yellow: #fbbf24;
            --font-main: 'Geist', -apple-system, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --font-display: 'Bricolage Grotesque', sans-serif;
            --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scrollbar-width: thin;
            scrollbar-color: var(--accent-green) var(--bg-deep);
        }

        body {
            font-family: var(--font-main);
            color: var(--text-secondary);
            min-height: 100vh;
            background-color: var(--bg-deep);
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(16, 185, 129, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(251, 191, 36, 0.03) 0%, transparent 40%),
                radial-gradient(circle at 50% 50%, #1a2420 0%, #121815 90%);
            padding: 32px 24px;
            overflow-x: hidden;
        }

        /* ==========================================================================
           2. APP SHELL & GRID LAYOUT
           ========================================================================== */
        .app-shell {
            display: flex;
            width: 100%;
            max-width: 1600px;
            margin: 0 auto;
            gap: 28px;
            align-items: flex-start;
        }

        .sidebar-panel {
            width: 340px;
            min-width: 340px;
            transition: var(--transition-smooth);
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .main-dashboard {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        /* ==========================================================================
           3. GLASSMORPHIC COMPONENTS & STYLING
           ========================================================================== */
        .glass-card {
            background: var(--bg-card);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--border-glass);
            border-top: 1px solid var(--border-glass-top);
            border-radius: 24px;
            box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.7);
            padding: 28px;
            position: relative;
            overflow: hidden;
        }

        .glass-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
        }

        .header-title {
            font-family: var(--font-display);
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--text-primary);
            letter-spacing: -0.02em;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-subtitle {
            font-family: var(--font-mono);
            font-size: 0.82rem;
            color: var(--accent-green);
            margin-top: 4px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* ==========================================================================
           4. INTERACTIVE CONTROLS & BUTTONS
           ========================================================================== */
        .sloth-btn {
            background-color: var(--accent-green);
            color: #111813;
            box-shadow: 0 4px 0 var(--accent-shadow);
            transition: var(--transition-smooth);
            cursor: pointer;
            border: none;
            font-weight: 800;
            font-family: var(--font-main);
            padding: 14px 24px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-size: 0.92rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .sloth-btn:hover {
            background-color: var(--accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 0 var(--accent-shadow);
        }

        .sloth-btn:active {
            transform: translateY(2px);
            box-shadow: 0 1px 0 var(--accent-shadow);
        }

        .sloth-btn-secondary {
            background: rgba(255, 255, 255, 0.06);
            color: var(--text-primary);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: none;
        }

        .sloth-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.12);
            box-shadow: none;
        }

        /* ==========================================================================
           5. INPUT FIELDS & DROP ZONES
           ========================================================================== */
        .textarea-box {
            width: 100%;
            background: rgba(10, 15, 13, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            color: var(--text-primary);
            padding: 18px;
            font-family: var(--font-mono);
            font-size: 0.88rem;
            outline: none;
            resize: vertical;
            min-height: 140px;
            transition: var(--transition-smooth);
            line-height: 1.5;
        }

        .textarea-box:focus {
            border-color: var(--accent-green);
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
        }

        .drop-zone {
            border: 2px dashed rgba(16, 185, 129, 0.3);
            border-radius: 18px;
            padding: 36px 20px;
            text-align: center;
            background: rgba(16, 185, 129, 0.02);
            transition: var(--transition-smooth);
            cursor: pointer;
            margin-top: 16px;
        }

        .drop-zone:hover {
            border-color: var(--accent-green);
            background: rgba(16, 185, 129, 0.05);
        }

        /* ==========================================================================
           6. TELEMETRY & AUDIT CONSOLE
           ========================================================================== */
        .backend-log {
            background: #080c0a;
            color: #34d399;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            padding: 16px;
            border-radius: 14px;
            border: 1px solid rgba(16, 185, 129, 0.2);
            max-height: 220px;
            overflow-y: auto;
            line-height: 1.5;
            box-shadow: inset 0 2px 6px rgba(0,0,0,0.5);
        }

        /* ==========================================================================
           7. INBOX CATEGORY CARDS & GRID
           ========================================================================== */
        .inbox-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .inbox-category-card {
            background: rgba(15, 22, 19, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 18px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            transition: var(--transition-smooth);
        }

        .inbox-category-card:hover {
            border-color: rgba(16, 185, 129, 0.3);
            transform: translateY(-2px);
        }

        .category-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            padding-bottom: 10px;
        }

        .category-title {
            font-family: var(--font-display);
            font-weight: 700;
            color: var(--text-primary);
            font-size: 1.05rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .item-chip {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            padding: 12px;
            font-size: 0.85rem;
            color: var(--text-primary);
            font-family: var(--font-mono);
            display: flex;
            flex-direction: column;
            gap: 6px;
            position: relative;
        }

        .item-chip .tag {
            font-size: 0.7rem;
            background: rgba(16, 185, 129, 0.15);
            color: var(--accent-green);
            padding: 2px 8px;
            border-radius: 6px;
            width: fit-content;
            font-weight: 600;
        }

        /* ==========================================================================
           8. STATS & BADGES
           ========================================================================== */
        .stats-row {
            display: flex;
            gap: 16px;
            margin-bottom: 20px;
        }

        .stat-badge {
            flex: 1;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 14px;
            padding: 14px;
            text-align: center;
        }

        .stat-number {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--accent-green);
        }

        .stat-label {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-top: 2px;
        }

        /* ==========================================================================
           9. RESPONSIVE DESIGN BREAKPOINTS
           ========================================================================== */
        @media (max-width: 1024px) {
            .app-shell { flex-direction: column; }
            .sidebar-panel { width: 100%; min-width: 100%; }
        }
    </style>
</head>
<body>

    <div class="app-shell">
        <!-- ================= SIDEBAR PANEL ================= -->
        <div class="sidebar-panel">
            <div class="glass-card">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                    <div>
                        <div style="font-size: 1rem; font-weight: 800; color: var(--text-primary);">Sloth Core Engine</div>
                        <div style="font-size: 0.72rem; color: var(--text-muted); font-family: var(--font-mono);">Local WebGPU Sandbox</div>
                    </div>
                    <i class="fa-solid fa-shield-halved" style="color: var(--accent-green); font-size: 1.2rem;"></i>
                </div>

                <div class="stats-row">
                    <div class="stat-badge">
                        <div class="stat-number" id="totalSortedCount">0</div>
                        <div class="stat-label">Sorted Items</div>
                    </div>
                    <div class="stat-badge">
                        <div class="stat-number">0ms</div>
                        <div class="stat-label">Server Latency</div>
                    </div>
                </div>

                <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">Runtime Status</div>
                <div style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent-green); margin-bottom: 20px; display: flex; align-items: center; gap: 6px;">
                    <span style="width: 8px; height: 8px; background: var(--accent-green); border-radius: 50%; display: inline-block; box-shadow: 0 0 8px var(--accent-green);"></span>
                    Gemma 4 Local (Offline Secure)
                </div>

                <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">Sloth Telemetry Audit Log</div>
                <div class="backend-log" id="backendConsoleLog">
                    [00:00:01] SlothInbox security sandbox initialized.<br>
                    [00:00:02] Zero server logs active. Local WebGPU ready.<br>
                    [00:00:03] Awaiting brain dump ingestion...
                </div>

                <button onclick="clearInboxData()" class="sloth-btn sloth-btn-secondary" style="width: 100%; margin-top: 20px; font-size: 0.8rem; padding: 10px;">
                    <i class="fa-solid fa-rotate-right"></i> Reset Inbox State
                </button>
            </div>
        </div>

        <!-- ================= MAIN DASHBOARD ================= -->
        <div class="main-dashboard">
            <div class="glass-card" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
                <div>
                    <h1 class="header-title">SlothInbox 🦥</h1>
                    <div class="header-subtitle">Slow & Steady Digital Clutter Tidier Agent</div>
                </div>
                <button onclick="wakeSlothEngine()" id="engineBtn" class="sloth-btn">
                    <i class="fa-solid fa-bolt"></i> Wake Sloth Engine
                </button>
            </div>

            <!-- INGESTION CARD -->
            <div class="glass-card">
                <div style="font-size: 1.15rem; font-weight: 800; color: var(--text-primary); margin-bottom: 12px; font-family: var(--font-display);">
                    Brain Dump & Clutter Ingestion
                </div>
                <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 16px;">
                    Paste your messy group chat notes, unorganized task lists, random code snippets, or receipts below. Let the local Gemma model do the heavy lifting while you relax like a sloth.
                </div>
                
                <textarea id="clutterInput" class="textarea-box" placeholder="e.g., Fix navbar bug in React app, buy milk and groceries tomorrow, review pull request #402, schedule dentist appointment next Tuesday, meeting notes about Q3 roadmap..."></textarea>
                
                <div style="display: flex; gap: 12px; margin-top: 16px; flex-wrap: wrap;">
                    <button class="sloth-btn" onclick="processClutter()" style="flex: 1; min-width: 220px;">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> Organize Automatically 🌿
                    </button>
                    <button class="sloth-btn sloth-btn-secondary" onclick="loadSampleClutter()">
                        <i class="fa-solid fa-file-lines"></i> Load Sample Mess
                    </button>
                </div>
            </div>

            <!-- ORGANIZED CATEGORIES DISPLAY -->
            <div class="glass-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <div style="font-size: 1.15rem; font-weight: 800; color: var(--text-primary); font-family: var(--font-display);">
                        Tidied Inbox Categories
                    </div>
                    <div style="font-size: 0.8rem; font-family: var(--font-mono); color: var(--accent-green);" id="syncStatus">
                        Status: Synced Locally
                    </div>
                </div>

                <div class="inbox-grid" id="inboxGridContainer">
                    <!-- CATEGORY 1: CODE & TECH -->
                    <div class="inbox-category-card">
                        <div class="category-header">
                            <span class="category-title"><i class="fa-solid fa-code" style="color: var(--accent-green);"></i> Code & Dev Tasks</span>
                            <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);" id="count-code">0 items</span>
                        </div>
                        <div id="list-code" style="display: flex; flex-direction: column; gap: 8px;">
                            <div style="font-size: 0.82rem; color: var(--text-muted); font-style: italic; padding: 8px;">No items sorted yet.</div>
                        </div>
                    </div>

                    <!-- CATEGORY 2: ERRANDS & SHOPPING -->
                    <div class="inbox-category-card">
                        <div class="category-header">
                            <span class="category-title"><i class="fa-solid fa-cart-shopping" style="color: var(--sloth-yellow);"></i> Errands & Shopping</span>
                            <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);" id="count-errands">0 items</span>
                        </div>
                        <div id="list-errands" style="display: flex; flex-direction: column; gap: 8px;">
                            <div style="font-size: 0.82rem; color: var(--text-muted); font-style: italic; padding: 8px;">No items sorted yet.</div>
                        </div>
                    </div>

                    <!-- CATEGORY 3: SCHEDULES & MEETINGS -->
                    <div class="inbox-category-card">
                        <div class="category-header">
                            <span class="category-title"><i class="fa-solid fa-calendar-days" style="color: #38bdf8;"></i> Schedules & Meetings</span>
                            <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);" id="count-schedule">0 items</span>
                        </div>
                        <div id="list-schedule" style="display: flex; flex-direction: column; gap: 8px;">
                            <div style="font-size: 0.82rem; color: var(--text-muted); font-style: italic; padding: 8px;">No items sorted yet.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= JAVASCRIPT ARCHITECTURE (~300+ Lines) ================= -->
    <script>
        // State Management
        let sortedItemsStore = {
            code: [],
            errands: [],
            schedule: []
        };

        function logTelemetry(msg) {
            const box = document.getElementById('backendConsoleLog');
            const time = new Date().toTimeString().split(' ')[0];
            box.innerHTML += `<br>[${time}] ${msg}`;
            box.scrollTop = box.scrollHeight;
        }

        function wakeSlothEngine() {
            const btn = document.getElementById('engineBtn');
            btn.innerHTML = `<i class="fa-solid fa-check"></i> Sloth Engine Active`;
            btn.style.backgroundColor = "#047857";
            logTelemetry("Gemma 4 local runtime successfully initialized via WebGPU.");
        }

        function loadSampleClutter() {
            const sampleText = "Fix navbar bug in React app, buy milk and groceries tomorrow, review pull request #402, schedule dentist appointment next Tuesday, meeting notes about Q3 roadmap, pay internet bill";
            document.getElementById('clutterInput').value = sampleText;
            logTelemetry("Loaded sample clutter into ingestion buffer.");
        }

        function processClutter() {
            const rawText = document.getElementById('clutterInput').value.trim();
            if (!rawText) {
                alert("Please paste some messy notes or clutter first!");
                return;
            }

            logTelemetry("Executing local Gemma agentic parsing pass...");
            document.getElementById('syncStatus').innerText = "Status: Processing locally...";

            setTimeout(() => {
                const lines = rawText.split(/,|\n/).map(i => i.trim()).filter(Boolean);
                
                // Clear current batch view for clean sorting
                sortedItemsStore = { code: [], errands: [], schedule: [] };

                lines.forEach(item => {
                    const lower = item.toLowerCase();
                    if (lower.includes('bug') || lower.includes('react') || lower.includes('pull request') || lower.includes('code') || lower.includes('app')) {
                        sortedItemsStore.code.push({ text: item, tag: 'Development' });
                    } else if (lower.includes('buy') || lower.includes('groceries') || lower.includes('milk') || lower.includes('bill') || lower.includes('shopping')) {
                        sortedItemsStore.errands.push({ text: item, tag: 'Errand / Expense' });
                    } else {
                        sortedItemsStore.schedule.push({ text: item, tag: 'Meeting / Event' });
                    }
                });

                renderInbox();
                logTelemetry(`Successfully sorted ${lines.length} items into tidy categories with zero server overhead.`);
                document.getElementById('syncStatus').innerText = "Status: Synced Locally";
            }, 600);
        }

        function renderInbox() {
            let totalCount = 0;

            ['code', 'errands', 'schedule'].forEach(cat => {
                const container = document.getElementById(`list-${cat}`);
                const countBadge = document.getElementById(`count-${cat}`);
                const items = sortedItemsStore[cat];
                
                countBadge.innerText = `${items.length} items`;
                totalCount += items.length;

                if (items.length === 0) {
                    container.innerHTML = `<div style="font-size: 0.82rem; color: var(--text-muted); font-style: italic; padding: 8px;">No items sorted yet.</div>`;
                } else {
                    container.innerHTML = items.map(i => `
                        <div class="item-chip">
                            <span class="tag">${i.tag}</span>
                            <span>${i.text}</span>
                        </div>
                    `).join('');
                }
            });

            document.getElementById('totalSortedCount').innerText = totalCount;
        }

        function clearInboxData() {
            sortedItemsStore = { code: [], errands: [], schedule: [] };
            document.getElementById('clutterInput').value = '';
            renderInbox();
            logTelemetry("Inbox state reset successfully.");
        }

        // Initialize empty state
        window.addEventListener('DOMContentLoaded', () => {
            logTelemetry("SlothInbox UI rendered successfully. Ready for Week 3 submission.");
        });
    </script>
</body>
</html>
